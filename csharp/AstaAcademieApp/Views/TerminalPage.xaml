<Page x:Class="AstaAcademieApp.Views.TerminalPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Terminal Asta" Background="#060A0F">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ══ TopBar terminal ═══════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="#0D1117" BorderBrush="#1e3a5f"
                BorderThickness="0,0,0,1" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="12" Height="12" Fill="#ef4444" Margin="0,0,6,0"/>
                    <Ellipse Width="12" Height="12" Fill="#f59e0b" Margin="0,0,6,0"/>
                    <Ellipse Width="12" Height="12" Fill="#10b981" Margin="0,0,16,0"/>
                    <TextBlock Text="ASTA TERMINAL v2.0" Foreground="#10b981"
                               FontFamily="Consolas" FontWeight="Bold" FontSize="13"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <!-- Indicateur DLL native -->
                    <Border x:Name="NativeIndicator" CornerRadius="4" Padding="8,3"
                            Background="#0D2818" Margin="0,0,12,0">
                        <TextBlock x:Name="NativeLabel" Text="● C++ NATIF" Foreground="#10b981"
                                   FontFamily="Consolas" FontSize="11"/>
                    </Border>
                    <TextBlock x:Name="TxtClock" Text="00:00:00" Foreground="#7099c0"
                               FontFamily="Consolas" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ Zone de sortie (RichTextBox colorisé) ══════════════════════════ -->
        <RichTextBox x:Name="TerminalOutput"
                     Grid.Row="1"
                     Background="#060A0F"
                     BorderThickness="0"
                     IsReadOnly="True"
                     FontFamily="Consolas"
                     FontSize="13"
                     Foreground="#00FF41"
                     Padding="16,10"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     AcceptsReturn="False"
                     IsDocumentEnabled="True">
            <RichTextBox.Resources>
                <Style TargetType="Paragraph">
                    <Setter Property="Margin" Value="0"/>
                    <Setter Property="LineHeight" Value="18"/>
                </Style>
            </RichTextBox.Resources>
        </RichTextBox>

        <!-- ══ Ligne d'entrée de commande ═════════════════════════════════════ -->
        <Border Grid.Row="2" Background="#0D1117" BorderBrush="#1e3a5f"
                BorderThickness="0,1,0,0" Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <!-- Invite dynamique : user@machine:~$ -->
                <TextBlock x:Name="PromptLabel"
                           Text="user@machine:~$ "
                           Foreground="#00FFFF"
                           FontFamily="Consolas"
                           FontSize="13"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>
                <TextBox x:Name="CommandInput"
                         Grid.Column="1"
                         Background="Transparent"
                         Foreground="#00FF41"
                         BorderThickness="0"
                         FontFamily="Consolas"
                         FontSize="13"
                         CaretBrush="#00FF41"
                         SelectionBrush="#20B2AA"
                         VerticalAlignment="Center"
                         KeyDown="CommandInput_KeyDown"/>
            </Grid>
        </Border>

        <!-- ══ Barre de statut ════════════════════════════════════════════════ -->
        <Border Grid.Row="3" Background="#0D1117" Padding="16,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtStatus" Text="Prêt." Foreground="#4a6fa5"
                           FontFamily="Consolas" FontSize="11"/>
                <TextBlock x:Name="TxtUptime" Text="Uptime: --" Grid.Column="1"
                           Foreground="#4a6fa5" FontFamily="Consolas" FontSize="11"/>
            </Grid>
        </Border>
    </Grid>
</Page>
