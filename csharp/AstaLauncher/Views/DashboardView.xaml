<UserControl x:Class="AstaLauncher.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="White">
    <Grid>
        <StackPanel>
            <TextBlock Text="📊 Dashboard Live" FontSize="28" FontWeight="Bold" Margin="0,0,0,20"/>
            
            <!-- KPIs -->
            <UniformGrid Columns="3" Height="110" Margin="0,0,0,20">
                <Border Background="#1565c0" CornerRadius="10" Margin="10">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="Total Utilisateurs" FontSize="14" Foreground="#eeeeee" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TxtTotalUsers" Text="0" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="#1b5e20" CornerRadius="10" Margin="10">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="Licences Actives" FontSize="14" Foreground="#eeeeee" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TxtActiveUsers" Text="0" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
                <Border Background="#b71c1c" CornerRadius="10" Margin="10">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="Erreurs Aujourd'hui" FontSize="14" Foreground="#eeeeee" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TxtErrors" Text="0" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>
            
            <Grid Height="350">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <Border Grid.Column="0" Background="#130000" BorderBrush="#ff2222" BorderThickness="1" Margin="10,0,10,0">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="📈 Graphique d'Activité" FontSize="18" FontWeight="Bold" Margin="0,0,0,10" HorizontalAlignment="Center"/>
                        <TextBlock Text="(Les données arriveront via l'API Go)" Foreground="#a1a1a1" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                
                <Border Grid.Column="1" Background="#130000" BorderBrush="#ff2222" BorderThickness="1" Margin="0,0,10,0">
                    <StackPanel Margin="20">
                        <TextBlock Text="🖥️ Serveur Local" FontSize="20" FontWeight="Bold" Foreground="#00ff41" Margin="0,0,0,20"/>
                        <TextBlock x:Name="TxtCpu" Text="CPU: --%" FontFamily="Consolas" FontSize="16" Margin="0,5"/>
                        <TextBlock x:Name="TxtRam" Text="RAM: -- MB" FontFamily="Consolas" FontSize="16" Margin="0,5"/>
                        <TextBlock x:Name="TxtUptime" Text="Uptime: --h --m" FontFamily="Consolas" FontSize="16" Margin="0,5"/>
                        
                        <Button Content="Actualiser le Système" Background="#330000" Foreground="White" BorderThickness="1" BorderBrush="#ff2222" Margin="0,40,0,0" Padding="10" Click="RefreshSys_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
