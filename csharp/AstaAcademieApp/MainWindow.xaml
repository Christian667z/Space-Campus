<Window x:Class="AstaAcademieApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Asta Académie v2.0.0" Height="740" Width="1280"
        WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent">

    <Border Background="{StaticResource BrushBgDark}" CornerRadius="12" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" ClipToBounds="True">
        <Grid>
            <Grid.ColumnDefinitions>
                <!-- Sidebar -->
                <ColumnDefinition Width="240"/>
                <!-- Main Content -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ================= SIDEBAR ================= -->
            <Border Grid.Column="0" Background="{StaticResource BrushBgSidebar}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header Sidebar (Logo) -->
                    <StackPanel Grid.Row="0" Margin="20,30,20,20">
                        <TextBlock Text="🎓" FontSize="42" HorizontalAlignment="Center"/>
                        <TextBlock Text="ASTA ACADÉMIE" FontSize="16" FontWeight="Black" Foreground="{StaticResource BrushPrimary}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                        <TextBlock Text="Sciences Informatiques" FontSize="11" Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Mini Stats -->
                    <Border Grid.Row="1" Background="#0affffff" CornerRadius="8" Margin="15,0,15,15" Padding="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                <TextBlock Text="🔥" FontSize="14" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TxtStreak" Text="3" FontSize="13" FontWeight="Bold" Foreground="#f59e0b" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="{StaticResource BrushBorder}"/>
                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                <TextBlock Text="⭐" FontSize="14" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TxtXP" Text="120" FontSize="13" FontWeight="Bold" Foreground="{StaticResource BrushPrimary}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Menu de Navigation -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Hidden">
                        <StackPanel Margin="5,0">
                            <Button Style="{StaticResource NavButtonStyle}" Foreground="{StaticResource BrushPrimary}" Click="BtnNavDashboard_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🏠" Margin="0,0,12,0" Width="20" TextAlignment="Center"/>
                                    <TextBlock Text="Accueil" FontWeight="Bold"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource NavButtonStyle}" Click="BtnNavSpaceAI_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🤖" Margin="0,0,12,0" Width="20" TextAlignment="Center"/>
                                    <TextBlock Text="Space AI"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource NavButtonStyle}" Click="BtnNavOracle_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔮" Margin="0,0,12,0" Width="20" TextAlignment="Center"/>
                                    <TextBlock Text="L'Oracle"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource NavButtonStyle}" Click="BtnNavTools_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔧" Margin="0,0,12,0" Width="20" TextAlignment="Center"/>
                                    <TextBlock Text="Outils"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource NavButtonStyle}" Click="BtnNavCourses_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📚" Margin="0,0,12,0" Width="20" TextAlignment="Center"/>
                                    <TextBlock Text="Cours"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource NavButtonStyle}" Click="BtnNavShortcuts_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚡" Margin="0,0,12,0" Width="20" TextAlignment="Center"/>
                                    <TextBlock Text="Raccourcis"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource NavButtonStyle}" Click="BtnNavDevSecurity_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🛡️" Margin="0,0,12,0" Width="20" TextAlignment="Center"/>
                                    <TextBlock Text="DevSecurity"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource NavButtonStyle}" Click="BtnNavTerminal_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text=">_" Margin="0,0,12,0" Width="20" TextAlignment="Center" FontFamily="Consolas" FontWeight="Bold" Foreground="#10b981"/>
                                    <TextBlock Text="Terminal"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource NavButtonStyle}" Click="BtnNavQuiz_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🧠" Margin="0,0,12,0" Width="20" TextAlignment="Center"/>
                                    <TextBlock Text="Quiz"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource NavButtonStyle}" Click="BtnNavNotes_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📝" Margin="0,0,12,0" Width="20" TextAlignment="Center"/>
                                    <TextBlock Text="Mes Notes"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource NavButtonStyle}" Click="BtnNavGrades_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📊" Margin="0,0,12,0" Width="20" TextAlignment="Center"/>
                                    <TextBlock Text="Moyennes"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Footer -->
                    <StackPanel Grid.Row="3" Margin="20" HorizontalAlignment="Center">
                        <TextBlock Text="Dev: Space | Asta Dev" FontSize="10" Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Promo 2024-2028" FontSize="10" Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ================= MAIN CONTENT ================= -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <!-- TopBar -->
                    <RowDefinition Height="60"/>
                    <!-- Dashboard Content -->
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- TopBar -->
                <Border Grid.Row="0" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1" MouseLeftButtonDown="TopBar_MouseLeftButtonDown" Background="Transparent">
                    <Grid Margin="20,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Search Box -->
                        <Border Grid.Column="0" Background="#0affffff" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="6" HorizontalAlignment="Left" Width="300" Height="36" Padding="10,0">
                            <Grid>
                                <TextBlock Text="🔍 Rechercher... (Ctrl+K)" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                <TextBox Background="Transparent" BorderThickness="0" Foreground="White" VerticalAlignment="Center" CaretBrush="White"/>
                            </Grid>
                        </Border>

                        <!-- Window Controls -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Indicateur DLL native -->
                            <Border x:Name="TopNativeIndicator" CornerRadius="4" Padding="8,3"
                                    Background="#0D2818" Margin="0,0,12,0" VerticalAlignment="Center">
                                <TextBlock x:Name="TopNativeLabel" Text="● C++ NATIF"
                                           Foreground="#10b981" FontFamily="Consolas" FontSize="11"
                                           FontWeight="Bold"/>
                            </Border>
                            <!-- Horloge en direct -->
                            <TextBlock x:Name="TxtTopClock" Text="00:00:00"
                                       Foreground="{StaticResource BrushPrimary}" FontWeight="Bold"
                                       VerticalAlignment="Center" Margin="0,0,16,0"
                                       FontFamily="Consolas" FontSize="13"/>
                            <Button Content="−" Width="30" Height="30" Background="Transparent"
                                    Foreground="{StaticResource BrushTextMuted}" BorderThickness="0"
                                    FontSize="18" Click="BtnMinimize_Click"/>
                            <Button Content="×" Width="30" Height="30" Background="Transparent"
                                    Foreground="#ef4444" BorderThickness="0" FontSize="18"
                                    FontWeight="Bold" Click="BtnClose_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Frame de Navigation Dynamique -->
                <Frame x:Name="MainFrame" Grid.Row="1" NavigationUIVisibility="Hidden"/>
            </Grid>
        </Grid>
    </Border>
</Window>
