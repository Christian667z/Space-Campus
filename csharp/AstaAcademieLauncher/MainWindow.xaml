<Window x:Class="AstaAcademieLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Asta Académie - Espace de Travail" Height="680" Width="1050"
        Background="#08000a" Foreground="White" WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" BorderBrush="#3d004d" BorderThickness="1">
    
    <Window.Resources>
        <!-- Lueur de neon pour le logo et boutons -->
        <DropShadowEffect x:Key="NeonGlow" Color="#bf00ff" BlurRadius="25" ShadowDepth="0" Opacity="0.8"/>
        <DropShadowEffect x:Key="ButtonGlow" Color="#ff0077" BlurRadius="15" ShadowDepth="0" Opacity="0.5"/>
        
        <!-- Style des boutons généraux -->
        <Style x:Key="LaunchBtnStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Padding" Value="35,18"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="8" BorderThickness="1" BorderBrush="#ff00ff">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#ff0066" Offset="0"/>
                                    <GradientStop Color="#7c00e6" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Effect" Value="{StaticResource NeonGlow}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style des boutons secondaires -->
        <Style x:Key="SecBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#15091c"/>
            <Setter Property="Foreground" Value="#d2a6ff"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="6" BorderThickness="1" BorderBrush="#4f2066" Background="#15091c">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2f153d"/>
                                <Setter Property="BorderBrush" Value="#8033b3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Grille Principale (Splittée en deux vues superposées) -->
        
        <!-- ÉCRAN DE SPLASH / DIAGNOSTIC -->
        <Grid x:Name="GridSplash" Visibility="Visible">
            <Grid.Background>
                <RadialGradientBrush Center="0.5,0.5" RadiusX="0.8" RadiusY="0.8">
                    <GradientStop Color="#2c0040" Offset="0"/>
                    <GradientStop Color="#08000d" Offset="1"/>
                </RadialGradientBrush>
            </Grid.Background>
            
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="600">
                <!-- Titre / Marque -->
                <TextBlock Text="☠️ ASTA ACADÉMIE" FontSize="36" FontWeight="Black" HorizontalAlignment="Center" Foreground="#ff0077" Effect="{StaticResource NeonGlow}"/>
                <TextBlock Text="ESPACE DE TRAVAIL ÉTUDIANT" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#bf00ff" Margin="0,5,0,40"/>
                
                <!-- Séquence des vérifications -->
                <Border Background="#12051a" CornerRadius="10" Padding="25" Margin="0,0,0,30" BorderBrush="#321440" BorderThickness="1">
                    <StackPanel>
                        <!-- Étape 1 : Fichiers principaux -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="📁 Validation de l'intégrité de l'application..." Foreground="#e0c7ff" FontSize="13"/>
                            <TextBlock x:Name="CheckAppStatus" Grid.Column="1" Text="Attente" Foreground="#77628c" FontWeight="Bold"/>
                        </Grid>
                        
                        <!-- Étape 2 : Base de données -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🛢️ Connexion à la base de données locale..." Foreground="#e0c7ff" FontSize="13"/>
                            <TextBlock x:Name="CheckDbStatus" Grid.Column="1" Text="Attente" Foreground="#77628c" FontWeight="Bold"/>
                        </Grid>

                        <!-- Étape 3 : Module de sécurité C++ -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🛡️ Initialisation du pont de sécurité local (CNG C++)..." Foreground="#e0c7ff" FontSize="13"/>
                            <TextBlock x:Name="CheckSecStatus" Grid.Column="1" Text="Attente" Foreground="#77628c" FontWeight="Bold"/>
                        </Grid>

                        <!-- Étape 4 : Connexion API & Updates -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🌐 Vérification du service d'apprentissage hors-ligne..." Foreground="#e0c7ff" FontSize="13"/>
                            <TextBlock x:Name="CheckNetStatus" Grid.Column="1" Text="Attente" Foreground="#77628c" FontWeight="Bold"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Barre de progression -->
                <ProgressBar x:Name="SplashProgress" Height="8" Minimum="0" Maximum="100" Value="15" Background="#150024" Margin="0,0,0,15" BorderThickness="0">
                    <ProgressBar.Template>
                        <ControlTemplate TargetType="ProgressBar">
                            <Grid x:Name="TemplateRoot">
                                <Border Background="{TemplateBinding Background}" CornerRadius="4"/>
                                <Border x:Name="PART_Indicator" CornerRadius="4" HorizontalAlignment="Left">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#ff0066" Offset="0"/>
                                            <GradientStop Color="#bf00ff" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                            </Grid>
                        </ControlTemplate>
                    </ProgressBar.Template>
                </ProgressBar>
                
                <TextBlock x:Name="SplashMessage" Text="Initialisation du système..." FontSize="12" Foreground="#8c7a9c" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
        
        <!-- DASHBOARD DE LANCEMENT -->
        <Grid x:Name="GridDashboard" Visibility="Collapsed">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#110218" Offset="0"/>
                    <GradientStop Color="#040008" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>
            
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar (Génération & Diagnostic rapide) -->
            <Border Grid.Column="0" Background="#0b0110" BorderBrush="#320645" BorderThickness="0,0,1,0" Padding="25">
                <Grid>
                    <StackPanel>
                        <!-- Logo & Titre -->
                        <TextBlock Text="☠️ ASTA ACADÉMIE" FontSize="20" FontWeight="Black" Foreground="#ff0077" Margin="0,10,0,2"/>
                        <TextBlock Text="SaaS Client V1.2.0" FontSize="11" Foreground="#8c3eb3" Margin="0,0,0,35"/>

                        <!-- État général -->
                        <TextBlock Text="RAPPORTS DE SANTÉ" FontSize="11" FontWeight="Bold" Foreground="#8c7a9c" Margin="0,0,0,15"/>
                        
                        <Border Background="#160821" CornerRadius="6" Padding="15" Margin="0,0,0,15">
                            <StackPanel>
                                <TextBlock Text="Base de données" FontSize="12" Foreground="#c2b0d4"/>
                                <TextBlock Text="🟢 OPTIMISÉE (LOCAL)" FontSize="11" FontWeight="Bold" Foreground="#00ff99" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#160821" CornerRadius="6" Padding="15" Margin="0,0,0,15">
                            <StackPanel>
                                <TextBlock Text="Sécurité C++" FontSize="12" Foreground="#c2b0d4"/>
                                <TextBlock Text="🟢 ACTIF (Fallbacks OK)" FontSize="11" FontWeight="Bold" Foreground="#00ff99" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#160821" CornerRadius="6" Padding="15" Margin="0,0,0,25">
                            <StackPanel>
                                <TextBlock Text="Mode de Fonctionnement" FontSize="12" Foreground="#c2b0d4"/>
                                <TextBlock Text="🟢 OFFLINE RAG HAUTE PERF" FontSize="11" FontWeight="Bold" Foreground="#00ff88" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Infos système -->
                        <TextBlock Text="DIAGNOSTIC MACHINE" FontSize="11" FontWeight="Bold" Foreground="#8c7a9c" Margin="0,0,0,12"/>
                        <TextBlock x:Name="TxtSystemStats" Text="CPU: Calcul... | RAM: Calcul..." FontSize="12" Foreground="#8c7a9c"/>
                    </StackPanel>
                    
                    <!-- Bouton Fermer -->
                    <Button VerticalAlignment="Bottom" Content="Quitter le Lanceur" Style="{StaticResource SecBtnStyle}" Click="BtnExit_Click"/>
                </Grid>
            </Border>

            <!-- Zone de contenu centrale -->
            <Grid Grid.Column="1" Margin="40">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header de bienvenue -->
                <StackPanel Grid.Row="0">
                    <TextBlock Text="Bonjour, Étudiant de Asta Academie !" FontSize="28" FontWeight="Bold" Foreground="#f3ebfc"/>
                    <TextBlock Text="Votre environnement universitaire hors-ligne hautement sécurisé est prêt." FontSize="14" Foreground="#a694b8" Margin="0,5,0,0"/>
                </StackPanel>

                <!-- Bouton géant central de lancement -->
                <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center">
                        <!-- Effet visuel neon -->
                        <Border Width="160" Height="160" CornerRadius="80" Margin="0,0,0,25" HorizontalAlignment="Center" Effect="{StaticResource NeonGlow}">
                            <Border.Background>
                                <RadialGradientBrush>
                                    <GradientStop Color="#7c00ff" Offset="0"/>
                                    <GradientStop Color="Transparent" Offset="1"/>
                                </RadialGradientBrush>
                            </Border.Background>
                            <Grid>
                                <TextBlock Text="🎓" FontSize="72" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        
                        <Button Content="DÉMARRER MON WORKSPACE" Style="{StaticResource LaunchBtnStyle}" Click="BtnLaunchWorkspace_Click" HorizontalAlignment="Center"/>
                        <TextBlock Text="Lance instantanément l'écosystème d'apprentissage Asta Academie" FontSize="12" Foreground="#78688a" Margin="0,15,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- Actions rapides du bas -->
                <Border Grid.Row="2" BorderBrush="#2b113d" BorderThickness="0,1,0,0" Padding="0,20,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Orientation="Horizontal">
                            <Button Content="⚙️ Mode Diagnostic" Style="{StaticResource SecBtnStyle}" Margin="0,0,10,0" Click="BtnDiagnostic_Click"/>
                            <Button Content="Guide d'Aide" Style="{StaticResource SecBtnStyle}" Margin="0,0,10,0" Click="BtnHelp_Click"/>
                            <Button Content="Admin" Style="{StaticResource SecBtnStyle}" Margin="0,0,10,0" Click="BtnOpenAdmin_Click"/>
                        </StackPanel>

                        <TextBlock Grid.Column="1" Text="Asta Académie © 2026. Tous droits réservés." FontSize="11" Foreground="#655675" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
