<Page x:Class="AstaAcademieApp.Views.ShortcutsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Raccourcis">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="30,30,30,16">
            <TextBlock Text="⚡ Raccourcis &amp; Références" FontSize="26" FontWeight="Black"
                       Foreground="{StaticResource BrushPrimary}" Margin="0,0,0,4"/>
            <TextBlock Text="Excel, Pièges Profs, Linux, Modèle OSI, Protocoles Réseau — données Python"
                       FontSize="13" Foreground="{StaticResource BrushTextMuted}"/>
        </StackPanel>

        <!-- Status bridge -->
        <Border Grid.Row="1" Margin="30,0,30,12" CornerRadius="6" Padding="12,8" Background="#0D1B0D">
            <TextBlock x:Name="TxtStatus" Text="⏳ Chargement…"
                       Foreground="#f59e0b" FontFamily="Consolas" FontSize="12"/>
        </Border>

        <!-- Tabs -->
        <TabControl Grid.Row="2" Margin="30,0,30,30" x:Name="MainTabs"
                    Background="Transparent"
                    BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}"/>
                    <Setter Property="Padding" Value="14,8"/>
                    <Setter Property="FontSize" Value="12"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource BrushAccent}"/>
                            <Setter Property="Background" Value="{StaticResource BrushBgCard}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </TabControl.Resources>

            <!-- Excel -->
            <TabItem Header="📊 Excel">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="12">
                    <StackPanel>
                        <TextBlock Text="Raccourcis Clavier" FontSize="14" FontWeight="Bold"
                                   Foreground="{StaticResource BrushAccent}" Margin="0,0,0,10"/>
                        <ItemsControl x:Name="ExcelShortcutsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource BrushBgCard}"
                                            BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                                            CornerRadius="5" Margin="0,0,0,4" Padding="12,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="180"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="90"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding key}"
                                                       FontFamily="Consolas" FontSize="12" FontWeight="Bold"
                                                       Foreground="{StaticResource BrushAccent}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding action}"
                                                       FontSize="12" Foreground="{StaticResource BrushTextWhite}"
                                                       VerticalAlignment="Center" TextWrapping="Wrap"/>
                                            <TextBlock Grid.Column="2" Text="{Binding niveau}"
                                                       FontSize="11" VerticalAlignment="Center"
                                                       HorizontalAlignment="Right"
                                                       Foreground="{StaticResource BrushPrimary}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Formules Vitales" FontSize="14" FontWeight="Bold"
                                   Foreground="{StaticResource BrushAccent}" Margin="0,20,0,10"/>
                        <ItemsControl x:Name="ExcelFormulasList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource BrushBgCard}"
                                            BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                                            CornerRadius="5" Margin="0,0,0,4" Padding="12,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="280"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding formule}"
                                                       FontFamily="Consolas" FontSize="11" FontWeight="Bold"
                                                       Foreground="#4fc3f7" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding description}"
                                                       FontSize="12" Foreground="{StaticResource BrushTextWhite}"
                                                       VerticalAlignment="Center" TextWrapping="Wrap"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Pièges Profs -->
            <TabItem Header="⚠️ Pièges Profs">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="12">
                    <ItemsControl x:Name="TrapsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#f59e0b" BorderThickness="1" CornerRadius="8"
                                        Margin="0,0,0,10" Padding="16,12"
                                        Background="{StaticResource BrushBgCard}">
                                    <StackPanel>
                                        <TextBlock FontSize="13" FontWeight="Bold" Foreground="#f59e0b" TextWrapping="Wrap">
                                            <Run Text="{Binding danger}"/>
                                            <Run Text=" ["/>
                                            <Run Text="{Binding matiere}"/>
                                            <Run Text="] — "/>
                                            <Run Text="{Binding piege}"/>
                                        </TextBlock>
                                        <TextBlock FontSize="11" Foreground="{StaticResource BrushTextMuted}"
                                                   Margin="0,4,0,0" FontStyle="Italic">
                                            <Run Text="❓ "/>
                                            <Run Text="{Binding question_type}"/>
                                        </TextBlock>
                                        <TextBlock FontSize="12" Foreground="#ef4444" Margin="0,4,0,0">
                                            <Run Text="❌ "/>
                                            <Run Text="{Binding erreur_classique}"/>
                                        </TextBlock>
                                        <TextBlock FontSize="12" Foreground="#10b981" Margin="0,4,0,0" TextWrapping="Wrap">
                                            <Run Text="✅ "/>
                                            <Run Text="{Binding bonne_reponse}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>

            <!-- Linux -->
            <TabItem Header="🐧 Linux">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="12">
                    <ItemsControl x:Name="LinuxList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource BrushBgCard}"
                                        BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                                        CornerRadius="5" Margin="0,0,0,4" Padding="12,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="200"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding cmd}"
                                                   FontFamily="Consolas" FontSize="12" FontWeight="Bold"
                                                   Foreground="#00ff41" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding description}"
                                                   FontSize="12" Foreground="{StaticResource BrushTextWhite}"
                                                   VerticalAlignment="Center" TextWrapping="Wrap"/>
                                        <TextBlock Grid.Column="2" Text="{Binding exemple}"
                                                   FontFamily="Consolas" FontSize="10"
                                                   Foreground="{StaticResource BrushTextMuted}"
                                                   VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>

            <!-- OSI -->
            <TabItem Header="🌐 Modèle OSI">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="12">
                    <ItemsControl x:Name="OsiList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource BrushBgCard}"
                                        BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                                        CornerRadius="6" Margin="0,0,0,6" Padding="14,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="50"/>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="200"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" FontFamily="Consolas" FontSize="16"
                                                   FontWeight="Bold" Foreground="{StaticResource BrushAccent}"
                                                   VerticalAlignment="Center">
                                            <Run Text="C"/><Run Text="{Binding numero}"/>
                                        </TextBlock>
                                        <TextBlock Grid.Column="1" Text="{Binding nom}"
                                                   FontSize="13" FontWeight="Bold"
                                                   Foreground="{StaticResource BrushTextWhite}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding role}"
                                                   FontSize="12" Foreground="{StaticResource BrushTextMuted}"
                                                   VerticalAlignment="Center" TextWrapping="Wrap"/>
                                        <TextBlock Grid.Column="3" Text="{Binding exemples}"
                                                   FontSize="11" Foreground="#4fc3f7"
                                                   VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>

            <!-- Protocoles -->
            <TabItem Header="📡 Protocoles">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="12">
                    <ItemsControl x:Name="ProtocolsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource BrushBgCard}"
                                        BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                                        CornerRadius="5" Margin="0,0,0,4" Padding="12,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="90"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" FontFamily="Consolas" FontSize="12"
                                                   FontWeight="Bold" Foreground="{StaticResource BrushAccent}"
                                                   VerticalAlignment="Center">
                                            <Run Text=":"/><Run Text="{Binding port}"/>
                                        </TextBlock>
                                        <TextBlock Grid.Column="1" Text="{Binding protocole}"
                                                   FontSize="12" FontWeight="Bold"
                                                   Foreground="{StaticResource BrushTextWhite}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding description}"
                                                   FontSize="11" Foreground="{StaticResource BrushTextMuted}"
                                                   VerticalAlignment="Center" TextWrapping="Wrap"/>
                                        <TextBlock Grid.Column="3" Text="{Binding type}"
                                                   FontSize="11" Foreground="{StaticResource BrushPrimary}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </Grid>
</Page>
