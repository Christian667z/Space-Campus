<Page x:Class="AstaAcademieApp.Views.DevSecurityPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="DevSecurity">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#0D1A0D"
                BorderBrush="#ef4444" BorderThickness="0,0,0,2" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="☠" FontSize="24" Foreground="#ef4444"
                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="CYBER-SÉCURITÉ &amp; HACKING" FontSize="16"
                               FontWeight="Bold" FontFamily="Consolas" Foreground="#ef4444"/>
                    <TextBlock Text="CTF · Cours Premium · Reconnaissance · Cryptographie"
                               FontSize="11" FontFamily="Consolas" Foreground="#666"/>
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtTotalScore" Text="🏆 0 XP"
                               FontSize="14" FontWeight="Bold" FontFamily="Consolas" Foreground="#f59e0b"/>
                    <TextBlock x:Name="TxtProgress" Text="0/10 missions"
                               FontSize="10" FontFamily="Consolas" Foreground="#666" HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Tabs -->
        <TabControl Grid.Row="1" Background="Transparent" BorderBrush="{StaticResource BrushBorder}">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}"/>
                    <Setter Property="Padding" Value="16,9"/>
                    <Setter Property="FontSize" Value="12"/>
                    <Setter Property="FontFamily" Value="Consolas"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="#ef4444"/>
                            <Setter Property="Background" Value="{StaticResource BrushBgCard}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </TabControl.Resources>

            <!-- ══ COURS HACKING PREMIUM ══ -->
            <TabItem Header="📚 Cours Hacking ⭐">
                <!-- Ce ContentControl switche entre lock screen et reader -->
                <ContentControl x:Name="HackingContent"/>
            </TabItem>

            <!-- ══ CTF MISSIONS ══ -->
            <TabItem Header="🚩 CTF Missions">
                <Grid Margin="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Mission list -->
                    <Border Grid.Column="0" Background="{StaticResource BrushBgCard}"
                            BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                            CornerRadius="8" Margin="0,0,14,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="MISSIONS" FontFamily="Consolas" FontSize="11"
                                       FontWeight="Bold" Foreground="#ef4444" Margin="14,12,14,8"/>
                            <ListBox Grid.Row="1" x:Name="MissionList" Background="Transparent"
                                     BorderThickness="0" SelectionChanged="MissionList_SelectionChanged">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Margin" Value="6,2"/>
                                        <Setter Property="Padding" Value="0"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </Grid>
                    </Border>

                    <!-- Mission detail -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#0D1A0D" BorderBrush="#ef4444"
                                BorderThickness="1" CornerRadius="8" Padding="18,14" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock x:Name="TxtMissionCategory" FontSize="10"
                                           FontFamily="Consolas" Foreground="#ef4444" Margin="0,0,0,4"/>
                                <TextBlock x:Name="TxtMissionTitle" FontSize="16"
                                           FontWeight="Bold" FontFamily="Consolas" Foreground="#f0f0f0" TextWrapping="Wrap"/>
                                <TextBlock x:Name="TxtMissionDesc" FontSize="13"
                                           Foreground="#aaa" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="20"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Background="{StaticResource BrushBgCard}"
                                BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                                CornerRadius="6" Padding="14,8" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="TxtMissionXP" Text="⭐ 50 XP"
                                           FontSize="13" FontWeight="Bold" FontFamily="Consolas" Foreground="#f59e0b"/>
                                <TextBlock x:Name="TxtDifficulty" FontSize="12"
                                           FontFamily="Consolas" Foreground="{StaticResource BrushTextMuted}" Margin="14,0,0,0"/>
                                <TextBlock x:Name="TxtMissionStatus" FontSize="12"
                                           FontFamily="Consolas" Foreground="#10b981" Margin="14,0,0,0"/>
                            </StackPanel>
                        </Border>

                        <Grid Grid.Row="2" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtFlag" Grid.Column="0" FontFamily="Consolas"
                                     FontSize="14" Background="{StaticResource BrushBgCard}"
                                     Foreground="#ef4444" BorderBrush="#ef4444" BorderThickness="1"
                                     Padding="12,8" KeyDown="TxtFlag_KeyDown"/>
                            <Button Grid.Column="1" Content="🚩 Valider" Margin="8,0,0,0"
                                    Padding="16,8" FontFamily="Consolas" FontWeight="Bold"
                                    Background="#ef4444" Foreground="White" BorderThickness="0"
                                    Click="BtnSubmitFlag_Click" Cursor="Hand"/>
                            <Button Grid.Column="2" Content="💡 Indice" Margin="8,0,0,0"
                                    Padding="12,8" FontFamily="Consolas"
                                    Style="{StaticResource NavButtonStyle}" Foreground="#f59e0b"
                                    Click="BtnHint_Click"/>
                        </Grid>

                        <TextBlock Grid.Row="3" x:Name="TxtFlagResult" FontSize="14"
                                   FontWeight="Bold" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,0,0,6"/>
                        <Border Grid.Row="4" x:Name="HintBorder" Background="#1A1A00"
                                BorderBrush="#f59e0b" BorderThickness="1" CornerRadius="6"
                                Padding="14,10" Margin="0,0,0,10" Visibility="Collapsed">
                            <TextBlock x:Name="TxtHint" FontSize="12" FontFamily="Consolas"
                                       Foreground="#f59e0b" TextWrapping="Wrap"/>
                        </Border>

                        <Border Grid.Row="5" Background="{StaticResource BrushBgCard}"
                                BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                                CornerRadius="6" Padding="14,10">
                            <StackPanel>
                                <TextBlock Text="COMPLÉTÉES" FontSize="10" FontFamily="Consolas"
                                           FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,6"/>
                                <ItemsControl x:Name="CompletedList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontFamily="Consolas"
                                                       FontSize="12" Foreground="#10b981" Margin="0,2"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                        <TextBlock Text="🔎 Commandes Nmap" FontSize="11" FontWeight="Bold"
                                   FontFamily="Consolas" Foreground="#f59e0b" Margin="0,12,0,8"/>
                        <ItemsControl x:Name="NmapList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource BrushBgCard}"
                                            BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                                            CornerRadius="4" Margin="0,0,0,3" Padding="12,6">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Cmd}" FontFamily="Consolas" FontSize="12" FontWeight="Bold" Foreground="#ef4444"/>
                                            <TextBlock Text="{Binding Desc}" FontSize="12" Foreground="{StaticResource BrushTextWhite}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="🔤 Encodages / Hash" FontSize="11" FontWeight="Bold"
                                   FontFamily="Consolas" Foreground="#f59e0b" Margin="0,12,0,8"/>
                        <ItemsControl x:Name="EncodingList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource BrushBgCard}"
                                            BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                                            CornerRadius="4" Margin="0,0,0,3" Padding="12,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="120"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" FontFamily="Consolas" FontSize="12" FontWeight="Bold" Foreground="#ef4444"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Desc}" FontSize="12" Foreground="{StaticResource BrushTextWhite}" TextWrapping="Wrap"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Example}" FontSize="11" Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                                <TextBlock x:Name="TxtNoCompleted" Text="Aucune mission complétée."
                                           FontSize="11" FontFamily="Consolas"
                                           Foreground="{StaticResource BrushTextMuted}" FontStyle="Italic"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ══ RÉFÉRENCE ══ -->
            <TabItem Header="🛡️ Référence">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="16">
                    <StackPanel>
                        <TextBlock Text="📖 Référence Rapide — Cybersécurité" FontSize="18"
                                   FontWeight="Bold" FontFamily="Consolas" Foreground="#ef4444" Margin="0,0,0,16"/>
                        <TextBlock Text="🌐 PORTS COMMUNS" FontSize="11" FontWeight="Bold"
                                   FontFamily="Consolas" Foreground="#f59e0b" Margin="0,0,0,8"/>
                        <ItemsControl x:Name="PortsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource BrushBgCard}"
                                            BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                                            CornerRadius="4" Margin="0,0,0,3" Padding="12,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Port}" FontFamily="Consolas"
                                                       FontSize="12" FontWeight="Bold" Foreground="#ef4444"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Protocol}"
                                                       FontFamily="Consolas" FontSize="12" Foreground="{StaticResource BrushAccent}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Description}"
                                                       FontSize="12" Foreground="{StaticResource BrushTextWhite}" TextWrapping="Wrap"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Page>
