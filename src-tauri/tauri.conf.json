{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Asta Académie",
  "version": "2.0.0",
  "identifier": "com.asta.campus.unashmoh",
  "build": {
    "beforeDevCommand": "npm run dev --workspace=frontend",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build --workspace=frontend",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Asta Académie • UNASMOH Promo 2028",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640,
        "decorations": false,
        "transparent": true,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#0b0f19"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https: data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
