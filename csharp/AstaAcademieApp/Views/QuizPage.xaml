<Page x:Class="AstaAcademieApp.Views.QuizPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Quiz">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="🧠 Quiz — Teste tes Connaissances" FontSize="26" FontWeight="Black"
                       Foreground="{StaticResource BrushPrimary}" Margin="0,0,0,4"/>
            <TextBlock Text="Questions universitaires L1→L4 — données depuis le backend Python"
                       FontSize="13" Foreground="{StaticResource BrushTextMuted}"/>
        </StackPanel>

        <!-- Score + Filtre -->
        <Border Grid.Row="1" Style="{StaticResource GlassCardStyle}"
                Background="{StaticResource BrushBgCard}" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtScore" Text="✅ Score : 0 / 0"
                               FontSize="18" FontWeight="Bold"
                               Foreground="#10b981" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtPct" Text="  (0%)"
                               FontSize="14" Foreground="{StaticResource BrushAccent}"
                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>

                <TextBlock Grid.Column="1" Text="Matière :" FontSize="12"
                           Foreground="{StaticResource BrushTextMuted}"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox Grid.Column="2" x:Name="CbMatiere" Width="150"
                          SelectionChanged="CbMatiere_SelectionChanged"
                          Margin="0,0,12,0"
                          Background="{StaticResource BrushBgCard}"
                          Foreground="{StaticResource BrushTextWhite}"/>
                <Button Grid.Column="3" Content="🔄 Reset" Click="BtnReset_Click"
                        Style="{StaticResource NavButtonStyle}"
                        Foreground="#ef4444"/>
            </Grid>
        </Border>

        <!-- Carte Question -->
        <Border Grid.Row="2" Style="{StaticResource GlassCardStyle}"
                BorderBrush="{StaticResource BrushAccent}"
                Background="{StaticResource BrushBgCard}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock x:Name="TxtMatiere" Text="" FontSize="11" FontWeight="Bold"
                           Foreground="{StaticResource BrushAccent}" Margin="0,0,0,6"/>
                <TextBlock x:Name="TxtQuestion"
                           Text="Clique sur 'Nouvelle Question' pour commencer !"
                           FontSize="16" Foreground="{StaticResource BrushTextWhite}"
                           TextWrapping="Wrap" LineHeight="24"/>
            </StackPanel>
        </Border>

        <!-- Options -->
        <UniformGrid Grid.Row="3" Rows="2" Columns="2" Margin="0,0,0,12">
            <Button x:Name="BtnA" Content="" Margin="0,0,6,6" Height="52" FontSize="13"
                    Style="{StaticResource NavButtonStyle}" Click="BtnOption_Click" Tag="0"
                    HorizontalContentAlignment="Left" Padding="14,0"/>
            <Button x:Name="BtnB" Content="" Margin="6,0,0,6" Height="52" FontSize="13"
                    Style="{StaticResource NavButtonStyle}" Click="BtnOption_Click" Tag="1"
                    HorizontalContentAlignment="Left" Padding="14,0"/>
            <Button x:Name="BtnC" Content="" Margin="0,0,6,0" Height="52" FontSize="13"
                    Style="{StaticResource NavButtonStyle}" Click="BtnOption_Click" Tag="2"
                    HorizontalContentAlignment="Left" Padding="14,0"/>
            <Button x:Name="BtnD" Content="" Margin="6,0,0,0" Height="52" FontSize="13"
                    Style="{StaticResource NavButtonStyle}" Click="BtnOption_Click" Tag="3"
                    HorizontalContentAlignment="Left" Padding="14,0"/>
        </UniformGrid>

        <!-- Résultat + Bouton suivant -->
        <Grid Grid.Row="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" x:Name="TxtResult" Text="" FontSize="15" FontWeight="Bold"
                       TextWrapping="Wrap" Margin="0,0,0,6"/>
            <TextBlock Grid.Row="1" x:Name="TxtExplication" Text="" FontSize="12"
                       Foreground="{StaticResource BrushTextMuted}" TextWrapping="Wrap"
                       Margin="0,0,0,16" LineHeight="20"/>
            <Button Grid.Row="2" x:Name="BtnNext" Content="▶ Nouvelle Question"
                    Click="BtnNext_Click"
                    Style="{StaticResource NavButtonStyle}"
                    Foreground="{StaticResource BrushPrimary}"
                    FontSize="14" FontWeight="Bold"
                    HorizontalAlignment="Left" Padding="20,10"/>
        </Grid>
    </Grid>
</Page>
