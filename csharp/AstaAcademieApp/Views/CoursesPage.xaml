<Page x:Class="AstaAcademieApp.Views.CoursesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Cours">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ══ Sidebar navigation ══ -->
        <Grid Grid.Column="0" Background="{StaticResource BrushBgCard}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="16,16,16,10">
                <TextBlock Text="📚 Programme UNASMOH"
                           FontSize="14" FontWeight="Bold"
                           Foreground="{StaticResource BrushPrimary}"/>
                <TextBlock Text="L1 → L4 + Python"
                           FontSize="11" Foreground="{StaticResource BrushTextMuted}"/>
            </StackPanel>

            <!-- Search -->
            <Border Grid.Row="1" Margin="10,0,10,8"
                    BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                    CornerRadius="6" Background="{StaticResource BrushBgDark}">
                <TextBox x:Name="TxtSearch" BorderThickness="0" Background="Transparent"
                         Foreground="{StaticResource BrushTextWhite}"
                         FontSize="12" Padding="8,6"
                         TextChanged="TxtSearch_TextChanged"/>
            </Border>

            <!-- Tree -->
            <TreeView Grid.Row="2" x:Name="CoursTree"
                      Background="Transparent" BorderThickness="0"
                      SelectedItemChanged="CoursTree_SelectedItemChanged">
                <TreeView.Resources>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="Foreground" Value="{StaticResource BrushTextWhite}"/>
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="Padding" Value="4,3"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#1A10B981"/>
                                <Setter Property="Foreground" Value="{StaticResource BrushAccent}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#0DFFFFFF"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TreeView.Resources>
            </TreeView>

            <!-- File count -->
            <TextBlock Grid.Row="3" x:Name="TxtFileCount" Text=""
                       FontSize="10" Foreground="{StaticResource BrushTextMuted}"
                       Margin="14,6,14,10"/>
        </Grid>

        <!-- ══ Reader panel ══ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Toolbar -->
            <Border Grid.Row="0" Background="{StaticResource BrushBgCard}"
                    BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1"
                    Padding="14,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TxtBreadcrumb"
                               Text="► Sélectionnez un cours dans la liste"
                               FontSize="12" Foreground="{StaticResource BrushTextMuted}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="A−" Width="28" Height="26" Margin="0,0,4,0"
                                Style="{StaticResource NavButtonStyle}"
                                Foreground="{StaticResource BrushTextMuted}"
                                Click="BtnFontMinus_Click"/>
                        <Button Content="A+" Width="28" Height="26" Margin="0,0,8,0"
                                Style="{StaticResource NavButtonStyle}"
                                Foreground="{StaticResource BrushTextMuted}"
                                Click="BtnFontPlus_Click"/>
                        <Button Content="📋 Copier" Height="26" Padding="8,0"
                                Style="{StaticResource NavButtonStyle}"
                                Foreground="{StaticResource BrushPrimary}"
                                Click="BtnCopy_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Content reader -->
            <ScrollViewer Grid.Row="1" x:Name="ReaderScroll"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="30,24">
                <TextBlock x:Name="TxtContent"
                           TextWrapping="Wrap" FontSize="14"
                           Foreground="{StaticResource BrushTextWhite}"
                           LineHeight="24" FontFamily="Segoe UI"
                           Text="Sélectionnez un fichier de cours dans la navigation à gauche."/>
            </ScrollViewer>

            <!-- Status bar -->
            <Border Grid.Row="2" Background="{StaticResource BrushBgCard}"
                    BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0"
                    Padding="14,5">
                <Grid>
                    <TextBlock x:Name="TxtWordCount" FontSize="10"
                               Foreground="{StaticResource BrushTextMuted}"
                               HorizontalAlignment="Left"/>
                    <TextBlock x:Name="TxtReadTime" FontSize="10"
                               Foreground="{StaticResource BrushPrimary}"
                               HorizontalAlignment="Right"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
