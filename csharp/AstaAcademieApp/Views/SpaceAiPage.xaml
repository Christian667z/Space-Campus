<Page x:Class="AstaAcademieApp.Views.SpaceAiPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="SpaceAiPage">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Chat History -->
            <RowDefinition Height="*"/>
            <!-- Input Area -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,20" Padding="15" Background="{StaticResource BrushBgCard}" CornerRadius="8" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="🤖" FontSize="32" Margin="0,0,15,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Space AI" FontSize="20" FontWeight="Black" Foreground="{StaticResource BrushAccent}"/>
                    <TextBlock Text="Assistant Pédagogique Intelligent" FontSize="12" Foreground="{StaticResource BrushTextMuted}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Chat History -->
        <Border Grid.Row="1" Background="#05ffffff" CornerRadius="12" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" Margin="0,0,0,20">
            <ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto" Padding="20">
                <StackPanel x:Name="ChatHistory" VerticalAlignment="Bottom">
                    <!-- Default Welcome Message -->
                    <Border Background="{StaticResource BrushBgCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="12,12,12,0" Padding="15" Margin="0,0,50,15" HorizontalAlignment="Left">
                        <StackPanel>
                            <TextBlock Text="Space AI" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushAccent}" Margin="0,0,0,5"/>
                            <TextBlock Text="Bonjour ! Je suis Space AI, votre assistant. Que souhaitez-vous réviser aujourd'hui ?" Foreground="{StaticResource BrushTextWhite}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Input Area -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <Border Grid.Column="0" Background="{StaticResource BrushBgCard}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="15,0" Margin="0,0,15,0">
                <TextBox x:Name="TxtInput" Background="Transparent" BorderThickness="0" Foreground="White" FontSize="14" VerticalAlignment="Center" CaretBrush="White" KeyDown="TxtInput_KeyDown"/>
            </Border>
            
            <Button Grid.Column="1" x:Name="BtnSend" Content="➤" FontSize="20" FontWeight="Bold" Width="50" Height="50" Background="{StaticResource BrushPrimary}" Foreground="White" BorderThickness="0" Click="BtnSend_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Grid>
</Page>
